# Local: every AWS service is reached through its SDK client at a local,
# AWS-compatible endpoint. .env.aws.example has the same keys for AWS.
GRADEBOOK_TABLE_NAME=gradebook_platform_data
AWS_REGION=eu-west-1
# Local stand-ins accept these; MinIO's root user in docker-compose.yml.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=locallocal

# Endpoints (unset on AWS)
DDB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
EVENTS_ENDPOINT=http://localhost:4010
SFN_ENDPOINT=http://localhost:8083
COGNITO_ENDPOINT=http://localhost:9229
LAMBDA_ENDPOINT=http://localhost:4011

# Resource names
EVENT_BUS_NAME=gradebook-local
REPORT_BUCKET=gradebook-report-cards
REPORT_STATE_MACHINE_NAME=gradebook-report-cards
REPORT_STATE_MACHINE_ARN=arn:aws:states:eu-west-1:123456789012:stateMachine:gradebook-report-cards
COGNITO_USER_POOL_NAME=gradebook
# Written by `npm run aws:setup` once the pool exists:
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
MODEL_BUCKET=gradebook-risk-models
RISK_SCORER_FUNCTION=risk-scorer
RISK_PREDICTION_FUNCTION=risk-prediction
MODEL_POINTER_TTL_SECONDS=5
# Counterfactual targets: the limits used when a model package has no data-derived caps
# (and always for T3M -> T3F marks), the number of DiCE options, and DiCE's seed.
# On AWS these belong in the risk-scorer Lambda's environment: the scorer runs DiCE.
COUNTERFACTUAL_STATIC_MARK_CAP=20
COUNTERFACTUAL_STATIC_ATTENDANCE_CAP=10
COUNTERFACTUAL_OPTIONS=3
COUNTERFACTUAL_SEED=20261

# Local stand-ins started by `npm run api` (not used on AWS)
PORT=4000
LOCAL_LAMBDA_PORT=4011
LOCAL_EVENTS_PORT=4010
SEED_PASSWORD=Gradebook-Dev-2026!
# Python 3 with backend/lambdas/risk-scorer/requirements.txt installed (python on Windows)
LOCAL_PYTHON=python3

# Web client
VITE_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
VITE_AWS_REGION=eu-west-1
VITE_COGNITO_ENDPOINT=http://localhost:9229
VITE_COGNITO_CLIENT_ID=

# AWS: the same keys as .env.example. Endpoints are left empty so every SDK
# client uses the real service. Credentials come from the Lambda execution role.
GRADEBOOK_TABLE_NAME=gradebook_platform_data
AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: do not set; the Lambda role provides credentials.

# Endpoints (unset on AWS)
DDB_ENDPOINT=
S3_ENDPOINT=
EVENTS_ENDPOINT=
SFN_ENDPOINT=
COGNITO_ENDPOINT=
LAMBDA_ENDPOINT=

# Resource names
EVENT_BUS_NAME=csg-platform-events
REPORT_BUCKET=csg-gradebook-report-cards-<account-id>
REPORT_STATE_MACHINE_NAME=gradebook-report-cards
REPORT_STATE_MACHINE_ARN=arn:aws:states:eu-west-1:<account-id>:stateMachine:gradebook-report-cards
COGNITO_USER_POOL_NAME=gradebook
COGNITO_USER_POOL_ID=eu-west-1_<pool-id>
COGNITO_CLIENT_ID=<app-client-id>
MODEL_BUCKET=csg-gradebook-risk-models-<account-id>
RISK_SCORER_FUNCTION=risk-scorer
RISK_PREDICTION_FUNCTION=risk-prediction
MODEL_POINTER_TTL_SECONDS=60
# Counterfactual targets: the limits used when a model package has no data-derived caps
# (and always for T3M -> T3F marks), the number of DiCE options, and DiCE's seed.
# On AWS these belong in the risk-scorer Lambda's environment: the scorer runs DiCE.
COUNTERFACTUAL_STATIC_MARK_CAP=20
COUNTERFACTUAL_STATIC_ATTENDANCE_CAP=10
COUNTERFACTUAL_OPTIONS=3
COUNTERFACTUAL_SEED=20261

# Local stand-ins started by `npm run api` (not used on AWS)
PORT=
LOCAL_LAMBDA_PORT=
LOCAL_EVENTS_PORT=
SEED_PASSWORD=
LOCAL_PYTHON=

# Web client
VITE_GRAPHQL_ENDPOINT=https://<appsync-id>.appsync-api.eu-west-1.amazonaws.com/graphql
VITE_AWS_REGION=eu-west-1
VITE_COGNITO_ENDPOINT=
VITE_COGNITO_CLIENT_ID=<app-client-id>

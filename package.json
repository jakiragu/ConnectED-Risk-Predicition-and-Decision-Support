{
  "name": "connected-ed-risk-prediction",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend/library",
    "frontend/react-app"
  ],
  "scripts": {
    "db:infra": "docker compose -f local/docker-compose.yml up -d",
    "db:down": "docker compose -f local/docker-compose.yml down",
    "db:create": "node local/create-table.js",
    "db:reset": "node local/create-table.js --reset",
    "db:seed": "node local/seed.js --reset",
    "db:verify": "node local/verify.js",
    "aws:setup": "node local/setup-aws.js",
    "api": "node local/server.js",
    "web": "npm run dev --workspace @connected/web",
    "build:web": "npm run build --workspace @connected/web",
    "setup": "npm run db:infra && node -e \"setTimeout(() => {}, 3000)\" && npm run aws:setup && npm run db:seed && npm run db:verify",
    "features:check": "node local/check-feature-contract.js",
    "features:export": "node local/export-features.js",
    "history:backfill": "node local/backfill-history.js",
    "model:package": "python ml/package_xgboost.py",
    "model:publish": "node local/publish-model.js",
    "test": "node --test tests/unit/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:evidence": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:report": "node tests/report.js",
    "test:env": "node tests/env.js"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.658.0",
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-eventbridge": "^3.658.0",
    "@aws-sdk/client-lambda": "^3.658.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/client-sfn": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "dotenv": "^16.4.5",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.7.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0"
  }
}
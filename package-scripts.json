{
  "test": "node --test tests/unit/*.test.js",
  "test:unit": "node --test tests/unit/*.test.js",
  "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
  "test:evidence": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
  "test:report": "node tests/report.js",
  "test:env": "node tests/env.js"
}
